    <string name="welcome_title">Bienvenido a CallsBlocker</string>
    <string name="welcome_desc">Esta aplicación te ayuda a bloquear llamadas no deseadas con una lista negra personalizada.\n\nToca siguiente para comenzar la configuración.</string>
    <string name="next">Siguiente</string>
    <string name="grant_access">Conceder acceso</string>
    <string name="screening_role_desc">Para bloquear llamadas de manera efectiva, debes establecer CallsBlocker como tu gestor de filtrado de llamadas. Esto permite que la aplicación intercepte las llamadas entrantes.</string>
    <string name="set_as_manager">Establecer como gestor</string>
    <string name="battery_exemption_title">Exención de optimización de batería</string>
    <string name="battery_exemption_desc">Algunos dispositivos suspenden las aplicaciones en segundo plano para ahorrar batería. Para garantizar que CallsBlocker continúe bloqueando llamadas, recomendamos eximir a la aplicación de la optimización de batería.</string>
