    <!-- Onboarding -->
    <string name="welcome_title">Benvenuto in CallsBlocker</string>
    <string name="welcome_desc">Questa app ti aiuta a bloccare le chiamate indesiderate con una blacklist personalizzata.\n\nTocca avanti per iniziare la configurazione.</string>
    <string name="next">Avanti</string>
    <string name="grant_access">Concedi accesso</string>
    <string name="screening_role_desc">Per bloccare effettivamente le chiamate, devi impostare CallsBlocker come gestore schermata chiamate. Questo permetterà all\'app di intercettare le chiamate in arrivo.</string>
    <string name="set_as_manager">Imposta come gestore</string>
    <string name="battery_exemption_title">Esenzione da ottimizzazione batteria</string>
    <string name="battery_exemption_desc">Alcuni dispositivi sospendono le app in background per risparmiare batteria. Per garantire che CallsBlocker continui a bloccare le chiamate, ti consigliamo di esentare l\'app dall\'ottimizzazione batteria.</string>
